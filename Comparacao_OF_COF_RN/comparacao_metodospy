# 2. LEITURA DOS DADOS
# 2. LEITURA DOS DADOS (Caminhos absolutos fixados)
datasets = {
    '0.2': pd.read_csv(
        r'C:\Users\Nat\Desktop\Projeto_Rede_Neural\database\data_occ0_2.csv'
    ),
    '0.5': pd.read_csv(
        r'C:\Users\Nat\Desktop\Projeto_Rede_Neural\database\data_occ0_5.csv'
    ),
    '0.7': pd.read_csv(
        r'C:\Users\Nat\Desktop\Projeto_Rede_Neural\database\data_occ0_7.csv'
    ),
    '0.9': pd.read_csv(
        r'C:\Users\Nat\Desktop\Projeto_Rede_Neural\database\data_occ0_9.csv'
    ),
}

colunas = ['sample(0)', 'sample(1)', 'sample(2)', 'sample(3)', 'sample(4)', 'sample(5)', 'sample(6)']

# 3. ARQUITETURA DA REDE NEURAL (MLP FINAL DE 3 CAMADAS)
base_model = MLPRegressor(
    hidden_layer_sizes=(20, 10, 5),
    activation='relu',
    alpha=0.0001,
    learning_rate_init=0.001,
    solver='adam',
    max_iter=500,
    random_state=42
)

# 4. ALGORITMOS DOS FILTROS ÓTIMOS
def optimalFilter2(train, test):
    def of2Weights():
        pulse = np.array([0.00002304, 0.01722640, 0.45244500, 1.0, 0.56330700, 0.14933500, 0.04235980])
        d_pulse = np.array([0.00004019, 0.00333578, 0.03108120, 0.00000000, -0.02434490, -0.00800683, -0.00243344])
        identidade = np.eye(7)
        b = np.zeros((10, 10))
        b[0:7, 0:7] = identidade
        b[0:7, 7] = -pulse
        b[0:7, 8] = -d_pulse
        b[0:7, 9] = -1
        b[7, 0:7] = pulse
        b[8, 0:7 ] = d_pulse
        b[9, 0:7 ] = 1

        c = np.zeros((10, 1))
        c[7] = 1
        
        aux = np.linalg.solve(b, c)
        return aux[0:7].flatten()

    weights = of2Weights()
    sample4 = []
    for i in range(len(test)):
        auxSample = test[i] * weights
        sample4.append(sum(auxSample))
    return sample4

def constrainedOptimalFilter(test, tol):
    pulse = np.array([0.00002304, 0.01722640, 0.45244500, 1.0, 0.56330700, 0.14933500, 0.04235980])
    S = np.array([
        [pulse[3],   pulse[4],   pulse[5],   pulse[6],   0.0,       0.0,        0.0     ],
        [pulse[2],   pulse[3],   pulse[4],   pulse[5],   pulse[6],  0.0,        0.0     ],
        [pulse[1],   pulse[2],   pulse[3],   pulse[4],   pulse[5],  pulse[6],   0.0     ],
        [pulse[0],   pulse[1],   pulse[2],   pulse[3],   pulse[4],  pulse[5],   pulse[6]],
        [0.0,        pulse[0],   pulse[1],   pulse[2],   pulse[3],  pulse[4],   pulse[5]],
        [0.0,        0.0,        pulse[0],   pulse[1],   pulse[2],  pulse[3],   pulse[4]],
        [0.0,        0.0,        0.0,        pulse[0],   pulse[1],  pulse[2],   pulse[3]]
    ])
    inv_S = np.linalg.inv(S)
    
    sample4 = []
    for samples in test:
        initial_estimative = inv_S @ samples
        cent = 3
        active_pulses = np.zeros(7)
        active_pulses[cent] = 1

        for j in range(7):
            if j == cent:
                continue
            if initial_estimative[j] > tol:
                active_pulses[j] = 1

        D_rows = []
        count = 0
        ind = 0
        
        for j in range(7):
            if active_pulses[j] == 1:
                if j == cent:
                    ind = count
                D_rows.append(S[j, :])
                count += 1
                
        D = np.array(D_rows)
        w = np.linalg.inv(D @ D.T) @ D
        out = samples @ w.T
        sample4.append(out[ind])
    return sample4   

# 5. ESTRUTURAS DE ARMAZENAMENTO DAS MÉTRICAS
kf_interno = KFold(n_splits=10, shuffle=True, random_state=42)
tabela_resultados = []

bins = [0, 50, 100, 150, 200, 300, np.inf]
labels = ['0-50', '50-100', '100-150', '150-200', '200-300', '>300']

# Listas para o gráfico
std_rn, std_of2, std_cof, occupancies = [], [], [], []

# 6. LOOP POR OCUPAÇÃO
for occ, df_occ in datasets.items():
    print(f"\nProcessing OCC {occ}...")
    
    # HOLDOUT EXTERNO (Dados Brutos para Teste)
    X_bruto = df_occ[colunas].values
    y_bruto = df_occ['AmplitudeSample(4)'].values
    
    X_dev_b, X_test_b, y_dev_b, y_test_b = train_test_split(
        X_bruto, y_bruto, test_size=0.2, random_state=42
    )

    # NORMALIZAÇÃO POR FAIXA (Para desenvolvimento da MLP)
    df_occ['Faixa'] = pd.cut(df_occ['AmplitudeSample(4)'], bins=bins, labels=labels)
    picos_faixa = df_occ.groupby('Faixa', observed=True)[colunas].max().max(axis=1)
    
    df_norm = df_occ.copy()
    for faixa in picos_faixa.index:
        idx = df_norm['Faixa'] == faixa
        df_norm.loc[idx, colunas] = df_norm.loc[idx, colunas] / picos_faixa[faixa]

    X_norm = df_norm[colunas].values
    y_norm = df_norm['AmplitudeSample(4)'].values

    X_dev_rn, X_test_rn, y_dev_rn, _ = train_test_split(
        X_norm, y_norm, test_size=0.2, random_state=42
    )

    # 10-FOLD INTERNO DA MLP
    for train_idx, val_idx in kf_interno.split(X_dev_rn):
        X_tr_fold, X_val_fold = X_dev_rn[train_idx], X_dev_rn[val_idx]
        y_tr_fold, _ = y_dev_rn[train_idx], y_dev_rn[val_idx]
        
        model_fold = clone(base_model)
        model_fold.fit(X_tr_fold, y_tr_fold)
    
    # TREINAMENTO CONSOLIDADO FINAL DA MLP
    mlp_final = clone(base_model)
    mlp_final.fit(X_dev_rn, y_dev_rn)
    
    # INFERÊNCIA NO CONJUNTO DE TESTE
    y_pred_rn = mlp_final.predict(X_test_rn)
    y_pred_of2 = np.array(optimalFilter2(X_test_b, X_test_b))
    y_pred_cof = np.array(constrainedOptimalFilter(X_test_b, tol=5))

    # CÁLCULO DOS RESÍDUOS
    res_rn = y_test_b - y_pred_rn
    res_of2 = y_test_b - y_pred_of2
    res_cof = y_test_b - y_pred_cof

    # CÁLCULO DAS MÉTRICAS (MAE e STD)
    mae_rn, std_rn_val = np.mean(np.abs(res_rn)), np.std(res_rn)
    mae_of2, std_of2_val = np.mean(np.abs(res_of2)), np.std(res_of2)
    mae_cof, std_cof_val = np.mean(np.abs(res_cof)), np.std(res_cof)

    # ARMAZENAMENTO DOS RESULTADOS DA TABELA
    tabela_resultados.append({
        'Occupancy': float(occ),
        'OF2_MAE': mae_of2,
        'OF2_STD': std_of2_val,
        'COF_MAE': mae_cof,
        'COF_STD': std_cof_val,
        'MLP_MAE': mae_rn,
        'MLP_STD': std_rn_val
    })

    # Listas para alimentar o gráfico
    std_rn.append(std_rn_val)
    std_of2.append(std_of2_val)
    std_cof.append(std_cof_val)
    occupancies.append(float(occ))

    print(f"  OF2 -> MAE: {mae_of2:.2f} | STD: {std_of2_val:.2f}")
    print(f"  COF -> MAE: {mae_cof:.2f} | STD: {std_cof_val:.2f}")
    print(f"  MLP -> MAE: {mae_rn:.2f} | STD: {std_rn_val:.2f}")

# 7. EXPORTAR TABELA CONSOLIDADA EM CSV
